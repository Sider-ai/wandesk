{
  "name": "wandesk",
  "version": "2.0.0",
  "description": "Wandesk —— 壳 + AI 内核 + workerd,应用一律是 worker 网站。",
  "author": "Wandesk",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n kernel,ui -c blue,magenta \"npm:dev:kernel\" \"npm:dev:ui\"",
    "dev:kernel": "tsx watch kernel/index.ts",
    "dev:ui": "vite",
    "build": "npm run build:overseer && npm run build:apps && vite build --config vite.config.ts && tsc -p tsconfig.kernel.json && node scripts/copy-assets.mjs",
    "build:overseer": "esbuild runtime/overseer.js --bundle --format=esm --outfile=dist/overseer.js --external:cloudflare:workers",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning dist/kernel/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.kernel.json",
    "app": "npm run build && electron .",
    "dist:mac": "node scripts/pack-mac.mjs",
    "build:apps": "node appsrc/build.mjs && node appsrc/build-chat.mjs",
    "dist:mac:release": "node scripts/pack-mac.mjs --release",
    "dist:win": "node scripts/pack-win.mjs"
  },
  "dependencies": {
    "marked": "^16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.170.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "workerd": "^1.20260827.1"
  },
  "main": "dist/shell/desktop/main.js",
  "build": {
    "appId": "ai.wandesk.desktop",
    "productName": "Wandesk",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "apps/**/*",
      "runtime/bin/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "npmRebuild": false,
    "dmg": {
      "sign": false,
      "artifactName": "${productName}_${version}_${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}_${version}_${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
